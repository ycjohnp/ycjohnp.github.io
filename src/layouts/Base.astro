---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import siteCard from '../assets/og/site.jpg';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  current?: 'projects' | 'about' | 'resume';
  /** The link-preview image. Defaults to the site card from scripts/og-card.py; project pages pass their own. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description = 'John Peng builds robots and the electronics inside them. Electrical and computer engineering at USC.',
  current,
  image = siteCard,
  imageAlt = 'John Peng, with a photo of the Cove robotic arm he helped build',
} = Astro.props;
const fullTitle = title ? `${title} | John Peng` : 'John Peng';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Link previews want an absolute URL and a 1.91:1 image; LinkedIn, Slack, Discord and iMessage all crop to it.
const card = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const cardUrl = Astro.site ? new URL(card.src, Astro.site).href : card.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="John Peng" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Runs before the page paints: mark that scripts run, and apply a theme the visitor picked with the
      // header toggle (see Header.astro), so a saved dark choice doesn't flash white first.
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <Header current={current} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Wipe each background sketch in once, as it scrolls into view (see .sketch in global.css). This checks
      // positions on scroll rather than using an IntersectionObserver: Chrome measures a target by its visible
      // area, and before the wipe a sketch is clipped down to its left edge, which is off screen for sketches
      // that bleed past the left of the page, so they'd never count as in view.
      const pending = new Set(document.querySelectorAll('.sketch'));
      function reveal() {
        // Anything whose top is above 90% of the window height, including sketches already scrolled past.
        const line = window.innerHeight * 0.9;
        for (const el of pending) {
          if (el.getBoundingClientRect().top < line) {
            el.classList.add('in');
            pending.delete(el);
          }
        }
        if (!pending.size) {
          window.removeEventListener('scroll', reveal);
          window.removeEventListener('resize', reveal);
        }
      }
      window.addEventListener('scroll', reveal, { passive: true });
      window.addEventListener('resize', reveal);
      reveal();
    </script>
    <script>
      // The favicon is a real ArUco marker (DICT_4X4_50). Scrolling steps it through the dictionary's ids,
      // one id per 100px. Each number is a marker's inner 4x4 cells, row by row, high bit first, 1 = black
      // (from cv2.aruco; public/favicon.svg and favicon.png are id 0, for before this runs).
      const MARKERS = [
        19149, 61541, 52434, 26297, 43873, 34354, 25041, 15117, 293, 12457, 1646, 61016, 61768, 54768, 56142,
        55745, 47514, 39423, 37793, 35152, 31092, 20436, 13098, 8829, 440, 27534, 21275, 23211, 57052, 52112,
        48106, 43085, 24880, 3892, 63313, 63190, 59274, 64256, 61961, 58277, 59623, 54743, 52595, 51021, 56087,
        53524, 53952, 46235, 45009, 45036,
      ];
      const STEP = 100;

      const canvas = document.createElement('canvas');
      canvas.width = canvas.height = 64;
      const ctx = canvas.getContext('2d')!;
      // One link that we keep pointing at the current marker; the static ones stay as the fallback.
      const link = document.createElement('link');
      link.rel = 'icon';
      link.type = 'image/png';

      function draw(id: number) {
        const bits = MARKERS[id];
        ctx.clearRect(0, 0, 64, 64);
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(0, 0, 64, 64, 10);
        ctx.fill();
        // 8x8 cells of 8px: a white quiet zone, the black border, and the 4x4 data cells inside it.
        ctx.fillStyle = '#111418';
        for (let row = 0; row < 6; row++) {
          for (let col = 0; col < 6; col++) {
            const border = row === 0 || row === 5 || col === 0 || col === 5;
            const black = border || (bits >> (15 - ((row - 1) * 4 + (col - 1)))) & 1;
            if (black) ctx.fillRect(8 + col * 8, 8 + row * 8, 8, 8);
          }
        }
        link.href = canvas.toDataURL('image/png');
        if (!link.isConnected) {
          document.querySelectorAll('link[rel="icon"]').forEach((el) => el.remove());
          document.head.append(link);
        }
      }

      // Redraws only when the id changes, so most scroll events do nothing.
      let shown = 0;
      window.addEventListener(
        'scroll',
        () => {
          const id = Math.floor(window.scrollY / STEP) % MARKERS.length;
          if (id !== shown) draw((shown = id));
        },
        { passive: true },
      );
    </script>
  </body>
</html>
