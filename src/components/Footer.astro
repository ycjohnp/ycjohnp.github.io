---
import { profile } from '../data/site';

// The page's HTML only has "johnpeng {at} usc [dot] edu", with the two halves in data attributes, so
// scrapers reading the HTML don't find an address. The script below turns it into a real mailto link.
const [user, domain] = profile.email.split('@');
const email = `${user} {at} ${domain.replaceAll('.', ' [dot] ')}`;
---

<footer id="contact" class="site-footer">
  <h2>Say hello</h2>
  <p class="big">
    Email is the best way to reach me: <span class="email" data-user={user} data-domain={domain}>{email}</span>.{' '}
    I'm also on <a href={profile.links.github}>GitHub</a> and <a href={profile.links.linkedin}>LinkedIn</a>.
  </p>
  <p class="copyright">© {new Date().getFullYear()} John Peng</p>
</footer>

<script>
  document.querySelectorAll<HTMLElement>('.email[data-user]').forEach((el) => {
    const address = `${el.dataset.user}@${el.dataset.domain}`;
    const link = document.createElement('a');
    link.href = `mailto:${address}`;
    link.textContent = address;
    el.replaceWith(link);
  });
</script>

<style>
  .site-footer {
    padding-top: 40px;
    border-top: 1px solid var(--ink);
  }

  h2 {
    margin: 0;
    font-size: 32px;
  }

  .big {
    margin: 14px 0 0;
  }

  .copyright {
    margin: 72px 0 0;
    padding: 20px 0 40px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }
</style>
