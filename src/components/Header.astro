---
import { existsSync } from 'node:fs';
import { url } from '../lib/url';

interface Props {
  current?: 'projects' | 'about';
}

const { current } = Astro.props;
// The Resume link appears once public/resume.pdf exists.
const hasResume = existsSync('public/resume.pdf');
---

<header class="site-header">
  <a class="name" href={url('/')}>John Peng</a>
  <nav aria-label="Main">
    <a href={url('/projects/')} aria-current={current === 'projects' ? 'page' : undefined}>Projects</a>
    <a href={url('/about/')} aria-current={current === 'about' ? 'page' : undefined}>About</a>
    {hasResume && <a href={url('/resume.pdf')}>Resume</a>}
    <a href="#contact">Contact</a>
    <button class="theme" type="button" aria-label="Switch to dark mode">
      <!-- A moon in light mode (click for dark) and a sun in dark mode (click for light). -->
      <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M16.6 11.6A6.8 6.8 0 1 1 8.4 3.4 6.4 6.4 0 0 0 16.6 11.6Z" />
      </svg>
      <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6" />
        <path d="M16.0 10.0L18.3 10.0M14.2 14.2L15.9 15.9M10.0 16.0L10.0 18.3M5.8 14.2L4.1 15.9M4.0 10.0L1.7 10.0M5.8 5.8L4.1 4.1M10.0 4.0L10.0 1.7M14.2 5.8L15.9 4.1" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // The theme toggle. With no saved choice the site follows the system setting (see global.css). Clicking
  // switches to the other theme and saves it, unless that's what the system wants anyway, in which case the
  // choice is cleared so the site goes back to following the system.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.site-header .theme')!;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

  function label() {
    button.setAttribute('aria-label', current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  }

  button.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const system = systemDark.matches ? 'dark' : 'light';
    try {
      if (next === system) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    if (next === system) delete root.dataset.theme;
    else root.dataset.theme = next;
    label();
  });
  systemDark.addEventListener('change', label);
  label();
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 22px 0;
    border-bottom: 1px solid var(--ink);
  }

  .name {
    font-weight: 600;
    font-size: 19px;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-right: -12px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
  }

  /* Only works with scripts, so it only shows with them. */
  .theme {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  :global(.js) .theme {
    display: inline-flex;
  }

  .theme:hover {
    color: var(--accent);
  }

  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Phones: tighten the nav so the name, the links and the toggle fit on one line down to 360px wide. They
     stay 44px tall, so they're still easy to tap. */
  @media (max-width: 480px) {
    .name {
      font-size: 18px;
    }

    nav {
      gap: 0;
      margin-right: -6px;
    }

    nav a {
      padding: 0 6px;
      font-size: 16px;
    }

    .theme {
      width: 34px;
    }
  }

  /* Which icon shows follows the same rules as the dark colors in global.css. */
  .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
</style>
