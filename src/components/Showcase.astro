---
// The home page's project showcase: one big image that steps through a few images per project (renders and
// photos), with the project's write-up beside it, a row of controls (previous, next, pause) and a row of
// project names underneath. It plays on its own, pauses while you're pointing at it or it's off screen, and
// stops once you pick something, until you press play again.
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/url';

interface Label {
  /** Where the leader line points, as % of the image width/height. */
  x: number;
  y: number;
  /** Which side of the point the text sits on. */
  side?: 'left' | 'right';
  text: string;
}

interface Shot {
  src: ImageMetadata;
  alt: string;
  /** A few words next to the controls saying what this image is. */
  caption: string;
  /** A render with a transparent background: no frame, so it sits on the grid. */
  cutout?: boolean;
  labels?: Label[];
}

interface Props {
  items: { project: CollectionEntry<'projects'>; shots: Shot[] }[];
}

const { items } = Astro.props;

// The stage is 4:3. Each image is fitted inside it without cropping, so its labels stay on the right spot.
const STAGE = 4 / 3;
const fit = (s: Shot) => {
  const a = s.src.width / s.src.height;
  return `width: ${Math.min(100, (a / STAGE) * 100).toFixed(2)}%; aspect-ratio: ${s.src.width} / ${s.src.height}`;
};
---

<div class="showcase" data-showcase>
  <div class="panel">
    <div class="stage grid-paper">
      {
        items.map(({ project, shots }, p) =>
          shots.map((s, i) => (
            <div class:list={['slide', { on: p === 0 && i === 0 }]} data-p={p} data-i={i} data-caption={s.caption}>
              <div class:list={['frame', { cutout: s.cutout }]} style={fit(s)}>
                <Image
                  src={s.src}
                  alt={s.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 960px) 100vw, 700px"
                  loading={p === 0 && i === 0 ? 'eager' : 'lazy'}
                />
                {s.labels?.map((l) => (
                  <span class:list={['label', l.side ?? 'right']} style={`left: ${l.x}%; top: ${l.y}%`} aria-hidden="true">
                    <span class="dot" />
                    <span class="leader" />
                    <span class="text">{l.text}</span>
                  </span>
                ))}
              </div>
            </div>
          )),
        )
      }
      <a
        class="hit"
        href={url(`/projects/${items[0].project.id}/`)}
        aria-label={`Read about ${items[0].project.data.title}`}
        draggable="false"></a>
    </div>
    <div class="side">
      <div class="abouts">
        {
          items.map(({ project }, p) => (
            <div class:list={['about', { on: p === 0 }]} data-p={p} inert={p !== 0}>
              <h3>
                <a href={url(`/projects/${project.id}/`)}>{project.data.title}</a>
              </h3>
              <p class="tag">{project.data.tagline}</p>
              <p class="sum">{project.data.summary}</p>
              <p class="ctx">{project.data.context}</p>
              <p class="read">
                <a href={url(`/projects/${project.id}/`)}>Read how it works</a>
              </p>
            </div>
          ))
        }
      </div>
      <div class="bar">
        <div class="captions">
          {
            items.map(({ shots }) =>
              shots.map((s) => (
                <span class="sizer" aria-hidden="true">
                  {s.caption}
                </span>
              )),
            )
          }
          <p class="caption" aria-live="off">{items[0].shots[0].caption}</p>
        </div>
        <div class="controls">
          <button type="button" class="ctl prev" aria-label="Previous image">←</button>
          <span class="count">1 of {items[0].shots.length}</span>
          <button type="button" class="ctl next" aria-label="Next image">→</button>
          <button type="button" class="ctl toggle" aria-label="Play slideshow">
            <svg class="icon-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M5.5 3.5v9M10.5 3.5v9" />
            </svg>
            <svg class="icon-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M5.5 3.5l7 4.5-7 4.5z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="tabs">
    {
      items.map(({ project }, p) => (
        <button type="button" class:list={['tab', { on: p === 0 }]} data-p={p} aria-pressed={p === 0 ? 'true' : 'false'}>
          <span class="track">
            <span class="fill" />
          </span>
          {project.data.title}
        </button>
      ))
    }
  </div>
</div>

<script>
  const SHOW_MS = 5000;
  // How far a finger has to travel sideways on the image to count as a swipe.
  const SWIPE_PX = 40;

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const hit = root.querySelector<HTMLAnchorElement>('.hit')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const abouts = [...root.querySelectorAll<HTMLElement>('.about')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const fills = tabs.map((t) => t.querySelector<HTMLElement>('.fill')!);
    const caption = root.querySelector<HTMLElement>('.caption')!;
    const count = root.querySelector<HTMLElement>('.count')!;
    const toggle = root.querySelector<HTMLButtonElement>('.toggle')!;
    const projectOf = (n: number) => Number(slides[n].dataset.p);
    const shotsIn = (p: number) => slides.filter((s) => Number(s.dataset.p) === p).length;

    let cur = 0;
    let elapsed = 0;
    // Autoplay stops once someone picks a project or steps through images, and starts again only if they
    // press play. It starts out stopped if they've asked their system for less motion.
    let playing = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hovered = false;
    let focused = false;
    let visible = true;

    function show(n: number) {
      cur = (n + slides.length) % slides.length;
      elapsed = 0;
      const p = projectOf(cur);
      const i = Number(slides[cur].dataset.i);
      slides.forEach((s, k) => s.classList.toggle('on', k === cur));
      // The write-ups are stacked in one spot (see .abouts), so the others are hidden rather than removed.
      abouts.forEach((a, k) => {
        a.classList.toggle('on', k === p);
        a.inert = k !== p;
      });
      tabs.forEach((t, k) => {
        t.classList.toggle('on', k === p);
        t.setAttribute('aria-pressed', String(k === p));
      });
      const title = abouts[p].querySelector('a')!;
      hit.href = title.href;
      hit.setAttribute('aria-label', `Read about ${title.textContent}`);
      caption.textContent = slides[cur].dataset.caption!;
      count.textContent = `${i + 1} of ${shotsIn(p)}`;
      paint();
    }

    // The blue line over the current project fills up across its images.
    function paint() {
      const p = projectOf(cur);
      const i = Number(slides[cur].dataset.i);
      const done = playing ? i + Math.min(elapsed / SHOW_MS, 1) : i + 1;
      fills.forEach((f, k) => (f.style.transform = `scaleX(${k === p ? done / shotsIn(p) : 0})`));
    }

    // The button shows pause while it plays and play while it's stopped. A screen reader is told about a new
    // caption only when it's stopped, so it isn't interrupted every five seconds by the slideshow.
    function sync() {
      root.toggleAttribute('data-playing', playing);
      toggle.setAttribute('aria-label', playing ? 'Pause slideshow' : 'Play slideshow');
      caption.setAttribute('aria-live', playing ? 'off' : 'polite');
      paint();
    }

    function stop() {
      playing = false;
      sync();
    }

    let last = 0;
    let frame = 0;
    function tick(now: number) {
      // Cap the step so coming back to a background tab doesn't skip ahead, but loosely enough that a
      // throttled tab drawing only a frame or two a second still keeps time.
      const dt = Math.min(now - last, 1000);
      last = now;
      if (playing && !hovered && !focused && visible) {
        elapsed += dt;
        if (elapsed >= SHOW_MS) show(cur + 1);
        else paint();
      }
      frame = playing ? requestAnimationFrame(tick) : 0;
    }

    function play() {
      playing = true;
      elapsed = 0;
      // The pointer or the focus is on the play button right now. Don't let that hold the slideshow still;
      // pointing at it or tabbing into it again pauses it as usual.
      hovered = focused = false;
      sync();
      if (!frame) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }

    if (playing) play();
    else sync();

    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(stage);
    root.addEventListener('pointerenter', () => (hovered = true));
    root.addEventListener('pointerleave', () => (hovered = false));
    // Only keyboard focus pauses it. A button keeps the focus after a click or a tap, and that shouldn't.
    root.addEventListener('focusin', (e) => (focused = (e.target as Element).matches(':focus-visible')));
    root.addEventListener('focusout', () => (focused = false));

    tabs.forEach((t, p) =>
      t.addEventListener('click', () => {
        stop();
        show(slides.findIndex((s) => Number(s.dataset.p) === p));
      }),
    );
    root.querySelector('.prev')!.addEventListener('click', () => {
      stop();
      show(cur - 1);
    });
    root.querySelector('.next')!.addEventListener('click', () => {
      stop();
      show(cur + 1);
    });
    toggle.addEventListener('click', () => (playing ? stop() : play()));
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      stop();
      show(cur + (e.key === 'ArrowRight' ? 1 : -1));
    });

    // Swiping sideways on the image steps through the images. Up-and-down movement is left to the browser
    // for scrolling the page (touch-action: pan-y on .stage), which cancels the pointer before pointerup.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    let swiped = false;
    stage.addEventListener('pointerdown', (e) => {
      swiped = false;
      tracking = e.pointerType !== 'mouse';
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) < SWIPE_PX || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      swiped = true;
      stop();
      show(cur + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => (tracking = false));
    // The image is a link to the project. A swipe that ends on it shouldn't also follow the link.
    hit.addEventListener('click', (e) => {
      if (swiped) e.preventDefault();
      swiped = false;
    });
  });
</script>

<style>
  .panel {
    display: flex;
    border: 1px solid var(--ink);
  }

  .stage {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-right: 1px solid var(--ink);
    /* Sideways drags are swipes (see the script); up-and-down ones still scroll the page. */
    touch-action: pan-y;
    /* Lets the labels ask how wide the stage is (see the @container rule below). */
    container-type: inline-size;
  }

  /* Insetting by the same % on every side keeps the slide 4:3, which fit() in the frontmatter relies on. */
  .slide {
    position: absolute;
    inset: 5%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.7s ease,
      visibility 0s 0.7s;
  }

  .slide.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.7s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.on {
      transition: none;
    }
  }

  .frame {
    position: relative;
    max-height: 100%;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .frame:not(.cutout) img {
    border: 1px solid var(--ink);
  }

  .label {
    position: absolute;
    display: flex;
    align-items: center;
    transform: translateY(-50%);
  }

  .label.left {
    flex-direction: row-reverse;
    transform: translate(-100%, -50%);
  }

  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--bg);
  }

  .leader {
    flex: none;
    width: 36px;
    height: 1px;
    background: var(--accent);
  }

  .text {
    width: max-content;
    max-width: 170px;
    padding: 3px 8px;
    border: 1px solid var(--accent);
    background: var(--bg);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.35;
  }

  /* Labels are a fixed size, so around an image in a stage narrower than this they'd run off its edge. */
  @container (max-width: 680px) {
    .label {
      display: none;
    }
  }

  /* The whole image links to the project. Nothing else sits on top of it, so nothing can cover a label. */
  .hit {
    position: absolute;
    inset: 0;
  }

  .side {
    flex: 0 0 320px;
    min-width: 0;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  /* Every project's write-up sits in the same grid cell and only the current one shows, so the panel is as
     tall as the longest one and doesn't change height from project to project. */
  .abouts {
    display: grid;
  }

  .about {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .about:not(.on) {
    visibility: hidden;
  }

  .about h3 {
    margin: 0;
    font-size: 30px;
  }

  .about h3 a {
    text-decoration: none;
  }

  .about h3 a:hover {
    text-decoration: underline;
  }

  .about p {
    margin: 0;
  }

  .tag {
    margin-top: 4px !important;
    font-size: 19px;
    color: var(--muted);
  }

  .sum {
    margin-top: 16px !important;
    color: var(--body);
  }

  .ctx {
    margin-top: 12px !important;
    font-size: 15px;
    color: var(--muted);
  }

  .read {
    margin-top: 16px !important;
  }

  /* What the image is, then the controls. Side by side where there's room; otherwise the caption goes on
     its own line with the controls under it, previous/next at the left and pause at the right. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  /* Same trick as .abouts: an invisible copy of every caption shares the cell with the real one, so a
     caption that wraps onto a second line doesn't make the panel taller for just that image. */
  .captions {
    flex: 999 1 220px;
    min-width: 0;
    display: grid;
    font-size: 15px;
    color: var(--muted);
  }

  .captions > * {
    grid-area: 1 / 1;
    margin: 0;
  }

  .sizer {
    visibility: hidden;
  }

  .controls {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ctl {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
  }

  .ctl:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .count {
    min-width: 52px;
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .toggle {
    margin-left: auto;
  }

  .toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The script sets data-playing while the slideshow runs: pause shows then, play otherwise. */
  .showcase[data-playing] .icon-play,
  .showcase:not([data-playing]) .icon-pause {
    display: none;
  }

  /* One name per project. The line over each is a progress bar while it plays. */
  .tabs {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 16px;
    margin-top: 16px;
  }

  .tab {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 0;
    border: none;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 16px;
    text-align: left;
    cursor: pointer;
  }

  .tab:hover,
  .tab.on {
    color: var(--ink);
  }

  .tab.on {
    font-weight: 600;
  }

  .track {
    display: block;
    height: 2px;
    margin-bottom: 10px;
    background: var(--rule);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Touch screens and narrow windows: everything you can press is at least 44px tall. */
  @media (max-width: 960px), (pointer: coarse) {
    .ctl {
      width: 44px;
      height: 44px;
    }

    .read {
      margin-top: 6px !important;
    }

    .read a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .tab {
      min-height: 44px;
    }
  }

  /* Any narrower and the image beside the write-up gets small, so the write-up goes underneath. The caption
     and controls move up to sit right under the image, above the write-up. */
  @media (max-width: 960px) {
    .panel {
      display: block;
    }

    .stage {
      border-right: none;
      border-bottom: 1px solid var(--ink);
    }

    .side {
      padding-top: 12px;
      gap: 20px;
    }

    .bar {
      order: -1;
      padding-top: 0;
      padding-bottom: 12px;
      border-top: none;
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 640px) {
    .side {
      padding: 12px 16px 20px;
    }

    .about h3 {
      font-size: 26px;
    }

    /* Six names don't fit across a phone, so they go in two rows of three. */
    .tabs {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px 12px;
    }
  }
</style>
