---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Sketch from '../components/Sketch.astro';
import Showcase from '../components/Showcase.astro';
import coveCad from '../assets/projects/cove/cad-cutout.png';
import coveWhiteboard from '../assets/projects/cove/arm-whiteboard.jpg';
import coveExtended from '../assets/projects/cove/arm-extended.jpg';
import tetherRender from '../assets/projects/tether/render.png';
import tetherSim from '../assets/projects/tether/sim-ladder-2.jpg';
import scramblerHand from '../assets/projects/scrambler/full-hand.jpg';
import scramblerTest from '../assets/projects/scrambler/test-setup.jpg';
import id0Robot from '../assets/projects/id0/robot-and-tools.jpg';
import modulesStacked from '../assets/projects/modular-robots/modules.jpg';
import modulesAssembled from '../assets/projects/modular-robots/assembled.jpg';
import skatemoTeam from '../assets/projects/skatemo/team.jpg';
import { degree, experience, profile } from '../data/site';
import { dateRange, monthYear } from '../lib/dates';
import { myPhoto } from '../lib/photos';
import { url } from '../lib/url';

const entry = async (id: string) => (await getEntry('projects', id))!;

// The showcase at the top: a few images per project, renders and real photos, in this order.
const showcase = [
  {
    project: await entry('cove'),
    shots: [
      {
        src: coveCad,
        alt: 'CAD render of the Cove 7-DOF robotic arm',
        caption: 'The CAD model',
        cutout: true,
        labels: [
          { x: 63, y: 9, side: 'left' as const, text: 'End effector at the wrist flange' },
          { x: 27, y: 56, side: 'left' as const, text: 'Damiao BLDC actuator, one of seven' },
          { x: 70, y: 52, text: 'Milled aluminum brackets' },
        ],
      },
      { src: coveWhiteboard, alt: 'The assembled Cove arm in front of a whiteboard of planning sketches', caption: 'The real arm, assembled' },
      { src: coveExtended, alt: 'The arm fully extended in a living room, wired up for testing', caption: 'Fully extended, wired up for testing' },
    ],
  },
  {
    project: await entry('tether'),
    shots: [
      { src: tetherRender, alt: 'Render of Tether hanging from a ladder rung by one end', caption: 'The render' },
      { src: tetherSim, alt: 'Simulated robot mid-step on the ladder', caption: 'Climbing a ladder in simulation' },
    ],
  },
  {
    project: await entry('scrambler'),
    shots: [
      {
        src: scramblerHand,
        alt: 'The Scrambler hand, with ArUco markers on each black finger and a blue wrist cuff',
        caption: 'The hand',
        labels: [
          { x: 64, y: 14, text: 'Cuff that fits the G1 wrist' },
          { x: 31, y: 66, side: 'left' as const, text: 'ArUco markers for FlexSense' },
          { x: 64, y: 86, text: 'TPU Fin Ray fingers' },
        ],
      },
      { src: scramblerTest, alt: 'The hand mounted on a test arm at the hackathon, next to a brick', caption: 'Testing at the hackathon' },
    ],
  },
  {
    project: await entry('id0'),
    shots: [{ src: id0Robot, alt: 'The ID0 robot next to a vase holding a flower, with printed tools on the floor', caption: 'ID0 and the tools it printed' }],
  },
  {
    project: await entry('modular-robots'),
    shots: [
      { src: modulesStacked, alt: 'Three modular robots, one stacked on top of two others', caption: 'Three modules, one stacked' },
      { src: modulesAssembled, alt: 'Four modules locked together into one larger robot', caption: 'Four modules locked into one robot' },
    ],
  },
  {
    project: await entry('skatemo'),
    shots: [{ src: skatemoTeam, alt: 'The SkateMo team holding the skateboard', caption: 'The team and the board' }],
  },
];

// Everything not in the showcase goes in the compact list underneath.
const inShowcase = new Set(showcase.map((s) => s.project.id));
const rest = await Promise.all(
  (await getCollection('projects', (p) => !inShowcase.has(p.id)))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (p) => ({
      project: p,
      preview: p.data.cover ? (await getImage({ src: p.data.cover, width: 480 })).src : undefined,
    })),
);
---

<Base>
  <section class="intro">
    <Sketch name="cove" width={640} top="0" right="-140px" />
    <div class="portrait">
      <Photo
        src={myPhoto('portrait')}
        alt="Portrait of John Peng"
        placeholder="Your portrait goes here"
        ratio="4 / 5"
        person
        eager
      />
    </div>
    <div class="intro-text">
      <h1>Hi, I'm John.</h1>
      <p class="big">
        I study electrical and computer engineering at USC, and I build robots. Most of my work sits where hardware and
        software meet: designing the board, writing the firmware, getting the motors to talk to ROS, and working out why
        something that ran fine yesterday doesn't today.
      </p>
      <p class="big">
        Right now I'm co-leading <a href={url('/projects/tether/')}>Tether</a> at Terra Labs, a 7-DOF inchworm robot made of
        three wireless modules. This past summer I interned on SRAM's Advanced Development team in Chicago.
      </p>
      <dl class="facts">
        <div>
          <dt>Studying</dt>
          <dd>B.S. {degree.field}, USC. Graduating {monthYear(degree.end)}.</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.location.replace(', CA', '')}</dd>
        </div>
        <div>
          <dt>Looking for</dt>
          <dd>A Summer 2027 internship in robotics, embedded systems or hardware</dd>
        </div>
        <div>
          <dt>Elsewhere</dt>
          <dd><a href={profile.links.github}>GitHub</a>, <a href={profile.links.linkedin}>LinkedIn</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <Sketch name="gear-pair" width={520} top="-150px" left="-200px" />
    <Sketch name="module" width={620} top="900px" left="-260px" />
    <div class="section-head">
      <h2>Things I've built</h2>
      <a href={url('/projects/')}>See all projects</a>
    </div>
    <Showcase items={showcase} />
    <h3 class="more-head">More projects</h3>
    <ul class="compact">
      {
        rest.map(({ project: p, preview }) => (
          <li>
            <a href={url(`/projects/${p.id}/`)} data-preview={preview}>
              <span class="ct">{p.data.title}</span>
              <span class="cg">{p.data.tagline}</span>
              <span class="cc">{p.data.context}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <img class="preview" alt="" aria-hidden="true" />
  </section>

  <section class="section">
    <Sketch name="gripper" width={380} top="-60px" right="-60px" />
    <Sketch name="aruco-board" width={820} bottom="0" left="-120px" />
    <h2>Where I've worked</h2>
    <div class="table-scroll">
      <table class="work">
        <thead>
          <tr><th scope="col">Where</th><th scope="col">Role</th><th scope="col">When</th></tr>
        </thead>
        <tbody>
          {
            experience.map((x) => (
              <tr>
                <td class="org">{x.org}</td>
                <td>{x.role}</td>
                <td class="when">{dateRange(x.start, x.end)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script>
    // In the compact list, a small preview image follows the pointer.
    const preview = document.querySelector<HTMLImageElement>('.preview');
    document.querySelectorAll<HTMLAnchorElement>('.compact a[data-preview]').forEach((a) => {
      a.addEventListener('mouseenter', () => {
        preview!.src = a.dataset.preview!;
        preview!.classList.add('on');
      });
      a.addEventListener('mouseleave', () => preview!.classList.remove('on'));
      a.addEventListener('mousemove', (e) => {
        preview!.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 80}px)`;
      });
    });
    // Scrolling moves the list out from under the pointer without a mouseleave, so hide it then too.
    addEventListener('scroll', () => preview!.classList.remove('on'), { passive: true });
  </script>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
    padding: 64px 0 104px;
  }

  .portrait {
    flex: 1 1 300px;
    max-width: 420px;
  }

  .intro-text {
    flex: 999 1 460px;
    min-width: 0;
    padding-top: 8px;
  }

  h1 {
    margin: 0 0 28px;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .intro-text .big {
    margin: 0 0 18px;
  }

  .facts {
    margin-top: 36px;
    max-width: 640px;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .work {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 16px;
  }

  .work th {
    text-align: left;
    font-weight: 500;
    font-size: 14px;
    color: var(--muted);
    padding: 0 16px 10px 0;
    border-bottom: 1.5px solid var(--ink);
  }

  .work td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.45;
  }

  .org {
    font-weight: 600;
  }

  .when {
    white-space: nowrap;
    color: var(--body);
  }

  @media (max-width: 640px) {
    .intro {
      gap: 32px;
      padding: 40px 0 56px;
    }
  }

  .more-head {
    margin: 48px 0 8px;
    font-size: 20px;
  }

  .compact {
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .compact a {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .ct {
    font-weight: 600;
    font-size: 18px;
  }

  .cg {
    color: var(--body);
  }

  .cc {
    font-size: 15px;
    color: var(--muted);
  }

  .compact a:hover .ct {
    text-decoration: underline;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: 240px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--ink);
    background: var(--bg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .preview.on {
    opacity: 1;
  }

  @media (hover: none) {
    .preview {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .compact a {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
