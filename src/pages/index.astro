---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CalloutFigure from '../components/CalloutFigure.astro';
import Sketch from '../components/Sketch.astro';
import coveCad from '../assets/projects/cove/cad-cutout.png';
import { degree, experience, profile } from '../data/site';
import { dateRange, monthYear } from '../lib/dates';
import { myPhoto } from '../lib/photos';
import { Image, getImage } from 'astro:assets';
import { url } from '../lib/url';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const top = featured.slice(0, 3);
const rest = await Promise.all(
  featured.slice(3).map(async (p) => ({
    project: p,
    preview: p.data.cover ? (await getImage({ src: p.data.cover, width: 480 })).src : undefined,
  })),
);
---

<Base>
  <section class="intro">
    <Sketch name="cove" width={640} top="0" right="-140px" />
    <div class="portrait">
      <Photo
        src={myPhoto('portrait')}
        alt="Portrait of John Peng"
        placeholder="Your portrait goes here"
        ratio="4 / 5"
        person
        eager
      />
    </div>
    <div class="intro-text">
      <h1>Hi, I'm John.</h1>
      <p class="big">
        I study electrical and computer engineering at USC, and I build robots. Most of my work sits where hardware and
        software meet: designing the board, writing the firmware, getting the motors to talk to ROS, and working out why
        something that ran fine yesterday doesn't today.
      </p>
      <p class="big">
        Right now I'm co-leading <a href={url('/projects/tether/')}>Tether</a> at Terra Labs, a 7-DOF inchworm robot made of
        three wireless modules. This past summer I interned on SRAM's Advanced Development team in Chicago.
      </p>
      <dl class="facts">
        <div>
          <dt>Studying</dt>
          <dd>B.S. {degree.field}, USC. Graduating {monthYear(degree.end)}.</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.location.replace(', CA', '')}</dd>
        </div>
        <div>
          <dt>Looking for</dt>
          <dd>A Summer 2027 internship in robotics, embedded systems or hardware</dd>
        </div>
        <div>
          <dt>Elsewhere</dt>
          <dd><a href={profile.links.github}>GitHub</a>, <a href={profile.links.linkedin}>LinkedIn</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <Sketch name="gear-pair" width={520} top="-150px" left="-200px" />
    <div class="section-head">
      <h2>Latest build: Cove<span class="tagline">7-DOF robotic arm</span></h2>
      <a href={url('/projects/cove/')}>Read how it works</a>
    </div>
    <CalloutFigure
      src={coveCad}
      alt="CAD render of the Cove 7-DOF robotic arm"
      callouts={[
        { x: 64, y: 10, text: 'End effector at the wrist flange' },
        { x: 79, y: 31, text: 'Damiao BLDC actuator, one of seven, torque-controlled over CAN' },
        { x: 67, y: 53, text: 'Aluminum brackets: eight parts milled from $308 of stock' },
        { x: 26, y: 82, side: 'left', text: 'Base mount, where the threads once stripped under load and took out four actuators' },
      ]}
    >
      <p>
        A 7-DOF arm that a student team at Terra Labs built from scratch in 10 weeks. I designed the control
        architecture and did the hardware/software integration.
      </p>
      <p slot="after" class="note">
        It runs ROS 2 on a Raspberry Pi 5, with an e-stop that cuts torque if the heartbeat stops. About 50 Nm of torque
        and 7 kg of payload at full reach. Shown to 200+ people at Demo Day.
      </p>
    </CalloutFigure>
  </section>

  <section class="section">
    <Sketch name="module" width={620} top="540px" left="-260px" />
    <Sketch name="arm-schematic" width={520} top="1100px" right="-170px" />
    <h2>Projects</h2>
    <p class="lede">Things I've built at work, in clubs, at hackathons, and on my own.</p>
    <div class="features">
      {
        top.map((p, i) => (
          <a class:list={['feature', { flip: i % 2 === 1 }]} href={url(`/projects/${p.id}/`)}>
            {p.data.cover && (
              <Image src={p.data.cover} alt={p.data.coverAlt ?? ''} widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 620px" />
            )}
            <div class="ftext">
              <h3>{p.data.title}</h3>
              <p class="ftag">{p.data.tagline}</p>
              <p class="fsum">{p.data.summary}</p>
              <p class="fctx">{p.data.context}</p>
            </div>
          </a>
        ))
      }
    </div>
    <h3 class="more-head">More projects</h3>
    <ul class="compact">
      {
        rest.map(({ project: p, preview }) => (
          <li>
            <a href={url(`/projects/${p.id}/`)} data-preview={preview}>
              <span class="ct">{p.data.title}</span>
              <span class="cg">{p.data.tagline}</span>
              <span class="cc">{p.data.context}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <img class="preview" alt="" aria-hidden="true" />
    <p><a href={url('/projects/')}>See all projects</a></p>
  </section>

  <section class="section">
    <Sketch name="gripper" width={380} top="-60px" right="-60px" />
    <Sketch name="aruco-board" width={820} bottom="0" left="-120px" />
    <h2>Where I've worked</h2>
    <div class="table-scroll">
      <table class="work">
        <thead>
          <tr><th scope="col">Where</th><th scope="col">Role</th><th scope="col">When</th></tr>
        </thead>
        <tbody>
          {
            experience.map((x) => (
              <tr>
                <td class="org">{x.org}</td>
                <td>{x.role}</td>
                <td class="when">{dateRange(x.start, x.end)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script>
    // In the compact list, a small preview image follows the pointer.
    const preview = document.querySelector<HTMLImageElement>('.preview');
    document.querySelectorAll<HTMLAnchorElement>('.compact a[data-preview]').forEach((a) => {
      a.addEventListener('mouseenter', () => {
        preview!.src = a.dataset.preview!;
        preview!.classList.add('on');
      });
      a.addEventListener('mouseleave', () => preview!.classList.remove('on'));
      a.addEventListener('mousemove', (e) => {
        preview!.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 80}px)`;
      });
    });
    // Scrolling moves the list out from under the pointer without a mouseleave, so hide it then too.
    addEventListener('scroll', () => preview!.classList.remove('on'), { passive: true });
  </script>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
    padding: 64px 0 104px;
  }

  .portrait {
    flex: 1 1 300px;
    max-width: 420px;
  }

  .intro-text {
    flex: 999 1 460px;
    min-width: 0;
    padding-top: 8px;
  }

  h1 {
    margin: 0 0 28px;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .intro-text .big {
    margin: 0 0 18px;
  }

  .facts {
    margin-top: 36px;
    max-width: 640px;
  }

  h2 .tagline {
    font-weight: 400;
    color: var(--muted);
  }

  h2 .tagline::before {
    content: ' – ';
  }

  .note {
    font-size: 15px;
    color: var(--muted);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .work {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 16px;
  }

  .work th {
    text-align: left;
    font-weight: 500;
    font-size: 14px;
    color: var(--muted);
    padding: 0 16px 10px 0;
    border-bottom: 1.5px solid var(--ink);
  }

  .work td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.45;
  }

  .org {
    font-weight: 600;
  }

  .when {
    white-space: nowrap;
    color: var(--body);
  }

  @media (max-width: 640px) {
    .intro {
      gap: 32px;
      padding: 40px 0 56px;
    }
  }

  /* The top three featured projects get big alternating rows; the rest are a compact list. */
  .features {
    border-top: 1.5px solid var(--ink);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .feature.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }

  .feature.flip img {
    order: 2;
  }

  .feature img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--ink);
  }

  .feature h3 {
    margin: 0;
    font-size: 30px;
  }

  .feature:hover h3 {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .ftag {
    margin: 4px 0 0;
    font-size: 19px;
    color: var(--muted);
  }

  .fsum {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
  }

  .fctx {
    margin: 16px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  .more-head {
    margin: 48px 0 8px;
    font-size: 20px;
  }

  .compact {
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .compact a {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .ct {
    font-weight: 600;
    font-size: 18px;
  }

  .cg {
    color: var(--body);
  }

  .cc {
    font-size: 15px;
    color: var(--muted);
  }

  .compact a:hover .ct {
    text-decoration: underline;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: 240px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--ink);
    background: var(--bg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .preview.on {
    opacity: 1;
  }

  @media (hover: none) {
    .preview {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .feature,
    .feature.flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .feature.flip img {
      order: 0;
    }

    .compact a {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
