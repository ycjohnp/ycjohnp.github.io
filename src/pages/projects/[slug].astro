---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Sketch from '../../components/Sketch.astro';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, tagline, summary, gallery, video, youtube, facts, links, sketches } = project.data;
// Spread the project's drawings down the page, alternating sides. Projects without drawings of their own
// get two of the general mechanism drawings, rotated by project so neighboring pages differ.
const general = ['gear-pair', 'linkage', 'cam-follower'];
const fallback = [general[project.data.order % 3], general[(project.data.order + 1) % 3]];
const placed = (sketches.length ? sketches : fallback).map((name, i, all) => ({
  name,
  top: `${(i * 92) / all.length + 2}%`,
  side: i % 2 === 0 ? { right: '-190px' } : { left: '-210px' },
  width: [560, 500, 600][i % 3],
}));
const { Content } = await render(project);
---

<Base title={`${title}: ${tagline}`} description={summary} current="projects">
  <article class="project">
    {placed.map((p) => <Sketch name={p.name} width={p.width} top={p.top} {...p.side} />)}
    <p class="crumb"><a href={url('/projects/')}>Projects</a></p>
    <h1>{title}<span class="tagline">{tagline}</span></h1>
    <p class="big">{summary}</p>

    {
      (gallery.length > 0 || video || youtube) && (
        <div class="gallery">
          {youtube && (
            <figure>
              <iframe
                class="video"
                src={`https://www.youtube-nocookie.com/embed/${youtube.id}?rel=0`}
                title={youtube.title}
                loading="lazy"
                allow="encrypted-media; picture-in-picture; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
              {youtube.caption && <figcaption>{youtube.caption}</figcaption>}
            </figure>
          )}
          {video && (
            <figure>
              <video
                class="video"
                src={url(video.src)}
                poster={video.poster && url(video.poster)}
                controls
                muted
                playsinline
                preload="metadata"
              />
              {video.caption && <figcaption>{video.caption}</figcaption>}
            </figure>
          )}
          {gallery.map((img) => (
            <figure>
              <Image src={img.src} alt={img.alt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="More projects">
    {
      prev ? (
        <a href={url(`/projects/${prev.id}/`)}>
          <span>Previous</span>
          {prev.data.title}
          <span>{prev.data.tagline}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={url(`/projects/${next.id}/`)}>
          <span>Next</span>
          {next.data.title}
          <span>{next.data.tagline}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .project {
    padding: 48px 0 0;
  }

  .crumb {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  h1 {
    margin: 12px 0 20px;
    font-size: clamp(40px, 6vw, 56px);
    letter-spacing: -0.02em;
  }

  h1 .tagline {
    display: block;
    margin-top: 10px;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.25;
    color: var(--muted);
  }

  .big {
    margin: 0 0 40px;
    max-width: 720px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img,
  .gallery video,
  .gallery iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--bg);
    border: 1px solid var(--ink);
  }

  .gallery video,
  .gallery iframe {
    background: var(--ink);
  }

  .gallery figcaption {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }

  .facts {
    max-width: 820px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .prose {
    max-width: 700px;
    padding: 24px 0 64px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--body);
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 26px;
    color: var(--ink);
  }

  .prose :global(ul) {
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  /* In Markdown, images on consecutive lines sit side by side, and an *italic* line
     directly under them becomes the caption. */
  .prose :global(p:has(> img)) {
    display: flex;
    flex-wrap: wrap;
    /* Without this, flex stretches every image to the tallest one's height. */
    align-items: flex-start;
    gap: 12px;
    margin: 28px 0;
  }

  .prose :global(p:has(> img) img) {
    flex: 1 1 220px;
    min-width: 0;
    height: auto;
    border: 1px solid var(--ink);
  }

  .prose :global(p:has(> img) em) {
    flex-basis: 100%;
    font-size: 14px;
    color: var(--muted);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 32px 0 72px;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    font-size: 21px;
    font-weight: 600;
    text-decoration: none;
  }

  .pager a span {
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .pager .next {
    text-align: right;
  }
</style>
